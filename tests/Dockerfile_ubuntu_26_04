FROM ubuntu:26.04

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y g++ make\
  libpcre2-dev libblas-dev liblapack-dev gfortran libtool libreadline-dev wget lzip mercurial automake

RUN apt-get update && apt-get --no-install-recommends install -y pkg-config octave octave-dev patch

RUN apt-get update && apt-get --no-install-recommends install -y libswscale-dev libavformat-dev libavcodec-dev

COPY ./video-*.tar.gz /app/

RUN octave --eval "pkg (\"install\", \"-verbose\", glob(\"video-*.tar.gz\"){1})"

CMD ["/usr/bin/octave"]
#CMD ["/bin/bash"]
